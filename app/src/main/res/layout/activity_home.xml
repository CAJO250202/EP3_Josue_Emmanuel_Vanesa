<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101818"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <!-- TOOLBAR DE NAVEGACIÓN -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#181818"
        app:title="Recetas"
        app:titleTextColor="@color/white"
        app:popupTheme="@style/CustomPopupMenu" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#181818"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:text="Cargando recetas del API..."
                android:textColor="@color/white"
                android:textSize="15sp" />

            <!-- CONSULTA 1: PASTA -->
            <TextView
                android:id="@+id/tvSeccionPasta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:text="Recetas de Pasta"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/contenedorPasta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- CONSULTA 2: TACOS -->
            <TextView
                android:id="@+id/tvSeccionTacos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:text="Recetas de Tacos"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/contenedorTacos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- CONSULTA 3: RECETAS ALEATORIAS -->
            <TextView
                android:id="@+id/tvSeccionAleatorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:text="Recetas Aleatorias"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/contenedorAleatorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
